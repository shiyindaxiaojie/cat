<?xml version="1.0" encoding="utf-8"?>
<server-config>
	<server id="default">
		<properties>
			<!-- 本地开发模式；启用后不访问 HDFS，并把模型查询线程固定为 5，不建议生产环境开启。 -->
			<property name="local-mode" value="false"/>
			<!-- 是否执行报表汇总、清理等定时任务；集群中通常只让少量节点承担。 -->
			<property name="job-machine" value="false"/>
			<!-- 是否承担通知发送任务。 -->
			<property name="send-machine" value="false"/>
			<!-- 是否执行告警计算任务；集群中应避免所有节点重复计算告警。 -->
			<property name="alarm-machine" value="false"/>
			<!-- 是否启用 HDFS 存储，设置为 false 时使用本地目录。 -->
			<property name="hdfs-enabled" value="false"/>
			<!-- CAT 控制台节点列表，格式为 host:HTTP端口，多个节点用英文逗号分隔；用于跨节点查询和跳转。 -->
			<property name="remote-servers" value="127.0.0.1:8080"/>

			<!-- TCP 接收线程：修改后需要重启。boss 只负责接受连接，通常 1 个足够。 -->
			<property name="netty-boss-threads" value="1"/>
			<!-- worker 负责网络读写和消息解码；修改后需要重启。 -->
			<property name="netty-worker-threads" value="1"/>

			<!--
				报表查询并发线程数。负责并行读取和合并 Transaction、Event 等报表模型，不参与消息接收或实时分析。
				调大可提高多报表并发查询能力，但会增加数据库、磁盘和 CPU 压力；修改后需要重启。
			-->
			<property name="report-query-threads" value="8"/>

			<!-- 单条 TCP 消息允许的最大字节数，当前为 4 MiB；超限消息会被拒绝，修改后需要重启。 -->
			<property name="max-message-size" value="4194304"/>

			<!--
				Kubernetes 发送 SIGTERM 时，CAT 会停止 TCP 接收、排空实时分析队列并完成最终落盘，不再需要 preStop curl。
				该超时应小于 Pod 的 terminationGracePeriodSeconds；默认 25 秒，建议 Pod 至少保留 30 秒。
			-->
			<property name="graceful-shutdown-timeout-seconds" value="25"/>
			<!--
				每天在线快照开关和执行时间。在线快照会刷新报表及原始消息文件，但不会关闭当前小时存储，也不会停止 TCP 接收。
				每个 StatefulSet Pod 都保存自己的实时数据，因此每个 Pod 都应执行；hour 为 0-23，minute 为 0-59。
			-->
			<property name="daily-checkpoint-enabled" value="true"/>
			<property name="daily-checkpoint-hour" value="4"/>
			<property name="daily-checkpoint-minute" value="0"/>

			<!--
				消息持久化线程数：负责把收到的消息写入本地或 HDFS 存储。
				每个线程都有一个独立队列；增加线程会同时增加并行写入量、内存占用和磁盘压力，修改后需要重启。
			-->
			<property name="message-processor-thread" value="8"/>
			<!--
				每个持久化线程的队列容量（消息条数）；所有持久化队列总容量约等于线程数乘以此值。
				队列满时新消息会被丢弃。
			-->
			<property name="message-processor-queue-size" value="5000"/>

			<!--
				每个实时分析器工作线程的默认队列容量（消息条数），不是整个 CAT 的全局队列大小。
				Transaction、Event、Problem 等分析器及其每个实例都会各自创建队列，调大后总内存占用会成倍增加。
				CAT 在每个整点创建下一小时的分析任务和队列；修改后从下一个整点开始生效，不需要重启。
				配置 “分析器名-analyzer-queue-capacity-per-thread” 时单独覆盖。
			-->
			<property name="realtime-analyzer-queue-capacity-per-thread" value="10000"/>

			<!-- 可选分析器开关：设置为 false 可减少对应分析器的线程、队列和报表聚合开销。 -->
			<!-- top：监控大盘分析，按分钟汇总各应用的错误类型和错误机器排行。 -->
			<property name="top-analyzer-enable" value="true"/>
			<!-- business：业务指标分析，聚合客户端上报的 Metric 业务指标。 -->
			<property name="business-analyzer-enable" value="true"/>
			<!-- matrix：性能报告分析，统计 URL、Service、RPC 等调用的成功率和耗时分布。 -->
			<property name="matrix-analyzer-enable" value="true"/>
			<!-- storage：统计数据库、缓存等存储调用的次数、耗时和错误情况。 -->
			<property name="storage-analyzer-enable" value="true"/>
			<!-- dependency：服务依赖分析，分析应用与数据库、缓存、服务等下游资源之间的依赖关系。 -->
			<property name="dependency-analyzer-enable" value="true"/>
		</properties>
		<storage local-base-dir="/data/appdatas/cat/bucket/" max-hdfs-storage-time="15" local-report-storage-time="2"
				 local-logivew-storage-time="1" har-mode="true" upload-thread="5">
			<hdfs id="dump" max-size="128M" server-uri="hdfs://127.0.0.1/" base-dir="/user/cat/dump"/>
			<harfs id="dump" max-size="128M" server-uri="har://127.0.0.1/" base-dir="/user/cat/dump"/>
			<properties>
				<property name="hadoop.security.authentication" value="false"/>
				<property name="dfs.namenode.kerberos.principal" value="hadoop/dev80.hadoop@testserver.com"/>
				<property name="dfs.cat.kerberos.principal" value="cat@testserver.com"/>
				<property name="dfs.cat.keytab.file" value="/data/appdatas/cat/cat.keytab"/>
				<property name="java.security.krb5.realm" value="value1"/>
				<property name="java.security.krb5.kdc" value="value2"/>
			</properties>
		</storage>
		<consumer>
			<long-config default-url-threshold="1000" default-sql-threshold="100" default-service-threshold="50">
				<domain name="cat" url-threshold="500" sql-threshold="500"/>
			</long-config>
		</consumer>
	</server>
	<server id="127.0.0.1">
		<properties>
			<property name="job-machine" value="true"/>
			<property name="send-machine" value="true"/>
			<property name="alarm-machine" value="true"/>
		</properties>
	</server>
</server-config>
